# ==============================================================================
# .npmrc — Configuração de Resolução Segura de Escopos (Hardening Anti-Dependency Confusion)
# ==============================================================================

# Roteamento estrito de namespace interno corporativo
@corp:registry=https://npm.corp.internal/
@corp:always-auth=true

# Registro público padrão para bibliotecas comunitárias de terceiros
registry=https://registry.npmjs.org/

